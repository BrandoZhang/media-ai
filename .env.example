# media-ai environment — copy to `.env` and fill in what you need.
#
# The CLI does NOT auto-load this file; it reads the *process* environment. Load it:
#   uv run --env-file .env media-ai image generate --prompt "x" --output x.png
#   # or:  set -a && . ./.env && set +a   (then run media-ai normally)
#
# You only need the block for the provider(s) you use. `mock` (the default) needs
# nothing. Never commit your real `.env` — only this example is committed.

# ── Which backend (optional) ─────────────────────────────────────────────
# mock (default, offline) | volc | openai | gemini | elevenlabs. A --model /
# --provider flag overrides this; a model id can also imply the provider.
MEDIA_PROVIDER=mock

# ── Volcengine Ark (volc) ────────────────────────────────────────────────
# API key (Bearer). ARK_API_KEY or VOLC_API_KEY.
ARK_API_KEY=
# Model IDs are ACCOUNT-SPECIFIC — a plain model name or a custom endpoint id
# (ep-2026...). Enable them in the Ark console; the built-in defaults likely
# aren't enabled for your account, so set these.
ARK_IMAGE_MODEL=            # e.g. doubao-seedream-4-5-251128  or  ep-2026...-img
ARK_VIDEO_MODEL=            # e.g. doubao-seedance-2-0-260128  or  ep-2026...-vid
# Optional:
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#ARK_IMAGE_SIZE=2K
#ARK_POLL_INTERVAL=5
#ARK_POLL_TIMEOUT=900

# ── OpenAI (openai) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional scoping / overrides:
#OPENAI_ORG=
#OPENAI_PROJECT=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_IMAGE_MODEL=gpt-image-2
#OPENAI_VIDEO_MODEL=sora-2

# ── Google Gemini (gemini) ───────────────────────────────────────────────
# GEMINI_API_KEY (preferred) or GOOGLE_API_KEY.
GEMINI_API_KEY=
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#GEMINI_IMAGE_MODEL=gemini-3.1-flash-image      # Nano Banana 2 (go-to); also -flash-lite-image / gemini-3-pro-image
#GEMINI_VIDEO_MODEL=veo-3.1-generate-preview     # also -fast- / -lite-generate-preview
#GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # also -pro-preview-tts / gemini-3.1-flash-tts-preview
#GEMINI_INLINE_MAX_BYTES=12582912               # refs past this (summed) upload via the Files API instead of inlining

# ── ElevenLabs (elevenlabs) — text-to-speech + dialogue ──────────────────
# Auth is the xi-api-key header. ELEVENLABS_API_KEY or ELEVEN_API_KEY.
ELEVENLABS_API_KEY=
#ELEVENLABS_MODEL=eleven_multilingual_v2          # default TTS model (speech generate)
#ELEVENLABS_DIALOGUE_MODEL=eleven_v3              # default dialogue model (speech dialogue)
#ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb         # default voice when --voice is omitted
#ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1 # e.g. a regional residency endpoint (api.eu.residency…)

# ── Credentials machinery (advanced, all optional) ───────────────────────
# Prefer keys via a secret-manager reference instead of a raw value here:
#MEDIA_SECRET_REF_OPENAI=env://OPENAI_API_KEY     # or op://…, vault://…, aws-sm://…
#MEDIA_SECRET_REF_VOLC=op://vault/volc/api_key
# chmod-600 TOML of raw keys ([openai] api_key="…"):
#MEDIA_CREDENTIALS_FILE=~/.config/media-ai/credentials.toml
# Profiles file (non-secret; [profiles.<name>] provider/model/base_url/credential):
#MEDIA_CONFIG_FILE=~/.config/media-ai/config.toml
#MEDIA_PROFILE=prod_video                          # select a profile by default
#MEDIA_DISABLE_KEYCHAIN=1                           # skip the OS keychain resolver
# Brokered/managed mode — the broker injects the key at egress; CLI holds only a token:
#MEDIA_CRED_BROKER=https://cred-broker.internal
#MEDIA_CRED_BROKER_TOKEN=<session-scoped token>

# ── CLI behavior (optional) ──────────────────────────────────────────────
#MEDIA_USAGE_LOG=./media_usage.jsonl               # per-task dir isolates concurrent runs
#MEDIA_LOG_LEVEL=warning                           # debug|info|warning|error (stderr, redacted)

# ── Live/integration tests (CI) ──────────────────────────────────────────
# Opt in to the network-hitting `-m live` tests; off unless set to 1.
#MEDIA_LIVE_TESTS=1
#MEDIA_LIVE_VIDEO=1                                # also run the (slow, costly) video smoke
