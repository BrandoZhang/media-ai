# media-ai credentials — persistent, per-user provider keys.
#
# This is ONE tier of the credential chain (see docs/CREDENTIALS.md). Use it when
# you want keys that persist across shells/projects, kept out of the repo. It is a
# HIGHER-priority source than environment variables / `.env`: if a provider's key
# is set in BOTH this file and the environment, THIS FILE WINS.
#
#   Prefer `.env` for quick/local/CI runs; prefer this file for durable local keys.
#   You do NOT need both — pick whichever fits, or use a broker/keychain/secret
#   manager (higher tiers still).
#
# Setup:
#   mkdir -p ~/.config/media-ai
#   cp credentials.toml.example ~/.config/media-ai/credentials.toml
#   # fill in the provider(s) you use, then lock it down:
#   chmod 600 ~/.config/media-ai/credentials.toml   # REQUIRED — a group/world
#                                                    # readable file is refused
# Override the location with $MEDIA_CREDENTIALS_FILE. Only include the block(s)
# you need; `mock` (the default provider) needs no credentials. Never commit a
# filled-in copy — only this .example is committed.

[openai]
api_key = "sk-..."

[gemini]
api_key = "..."          # GEMINI_API_KEY / GOOGLE_API_KEY value

[volc]
api_key = "..."          # ARK_API_KEY / VOLC_API_KEY value

[elevenlabs]
api_key = "..."          # ELEVENLABS_API_KEY value

# --- secret-manager reference instead of a raw key -------------------------
# Any `api_key` (or `key`) that looks like a reference is resolved through the
# secret-manager tier instead of being used verbatim, e.g.:
#   [openai]
#   api_key = "op://vault/openai/key"      # 1Password, Vault, aws-sm://, env://VAR, …
# Register a backend with media_ai.credentials.stores.register_secret_backend().
