# media-ai credentials — named, raw provider keys (the SECRET half of the config).
#
# This file is one consistent namespace of **named credentials**. Its companion,
# config.toml (config.toml.example), is a namespace of **named profiles** that
# reference these credentials by name — the two files are keyed the same way, so a
# profile in config.toml says `credential = "cred://<name>"` and it resolves the
# `[credentials.<name>]` block here. Secrets stay in THIS chmod-600 file; only
# non-secret references live in the shareable config.toml.
#
# This is ONE tier of the credential chain (see docs/CREDENTIALS.md). Use it for
# keys that persist across shells/projects, kept out of the repo. It is a
# HIGHER-priority source than environment variables / `.env`: if a provider's key
# is set in BOTH this file and the environment, THIS FILE WINS.
#
# Setup:
#   mkdir -p ~/.config/media-ai
#   cp credentials.toml.example ~/.config/media-ai/credentials.toml
#   # fill in the credential(s) you use, then lock it down:
#   chmod 600 ~/.config/media-ai/credentials.toml   # REQUIRED — a group/world
#                                                    # readable file is refused
# Override the location with $MEDIA_CREDENTIALS_FILE. Only include the block(s)
# you need; `mock` (the default provider) needs no credentials. Never commit a
# filled-in copy — only this .example is committed.

# ── Provider defaults (the simple case) ───────────────────────────────────
# A named credential whose name MATCHES a provider is that provider's default —
# what the plain chain resolves for `--provider openai` with no profile. The bare
# `[openai]` shorthand below is equivalent to `[credentials.openai]`.

[openai]
api_key = "sk-..."

[gemini]
api_key = "..."          # GEMINI_API_KEY / GOOGLE_API_KEY value

[volc]
api_key = "..."          # ARK_API_KEY / VOLC_API_KEY value

[elevenlabs]
api_key = "..."          # ELEVENLABS_API_KEY value

# ── Named credentials (multiple keys per provider, per model/endpoint) ─────
# A provider can have MANY keys — different accounts/tenants/models — each a named
# credential referenced from a config.toml profile as `cred://<name>`. Define as
# many as you like (even more than you routinely use); a profile's fallback list
# then picks whichever resolves at call time.
#
# [credentials.volc_account_a]
# api_key = "..."                       # e.g. the account behind your image endpoint
#
# [credentials.volc_account_b]
# api_key = "..."                       # e.g. the account behind your video endpoint
#
# [credentials.volc_shared]
# api_key = "op://vault/volc/shared"    # a named credential MAY itself be a
#                                       # secret-manager reference (resolved lazily)

# --- secret-manager reference instead of a raw key -------------------------
# Any `api_key` (or `key`, on a provider-default OR a named credential) that looks
# like a reference is resolved through the secret-manager tier instead of being used
# verbatim, e.g.:
#   [credentials.openai_prod]
#   api_key = "op://vault/openai/key"    # 1Password, Vault, aws-sm://, env://VAR, …
# Register a backend with media_ai.credentials.stores.register_secret_backend().
