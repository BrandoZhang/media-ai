# media-ai credentials — your provider keys, one block per account. SECRET; chmod 600.
#
# credentials.toml is a flat list of *accounts*: each `[<name>]` block is a name you
# choose plus its key. A config.toml profile then picks an account by name
# (`cred://<name>`). The name is just a label — the profile's `provider =` field
# decides which backend the key is used with, not the name.
#
# The simple case stays simple: an account named after a provider is that provider's
# default (what `--provider openai` uses when no profile selects something else).
#
# Setup:
#   mkdir -p ~/.config/media-ai
#   cp credentials.toml.example ~/.config/media-ai/credentials.toml
#   chmod 600 ~/.config/media-ai/credentials.toml   # REQUIRED — a group/world
#                                                    # readable file is refused
# Override the location with $MEDIA_CREDENTIALS_FILE. Keep only the block(s) you use;
# `mock` (the default provider) needs none. Never commit a filled-in copy.

# ── Provider defaults (one key per provider — the common case) ─────────────
[openai]
api_key = "sk-..."

[gemini]
api_key = "..."          # GEMINI_API_KEY / GOOGLE_API_KEY value

[volc]
api_key = "..."          # ARK_API_KEY / VOLC_API_KEY value

[elevenlabs]
api_key = "..."          # ELEVENLABS_API_KEY value

# ── Extra accounts (multiple keys per provider — per account / tenant / model) ──
# Define as many as you like — even more than you routinely use — and a profile's
# fallback list picks whichever resolves at call time. These pair with the profiles
# in config.toml.example (cred://volc_account_a → [volc_account_a], etc.).
[volc_account_a]
api_key = "..."

[volc_account_b]
api_key = "..."

# An account's key may itself be a secret-manager reference (resolved lazily), so the
# raw secret need not live in this file at all:
# [volc_shared]
# api_key = "op://vault/volc/shared"   # op:// , vault:// , aws-sm:// , env://VAR , …
