# media-ai — the secret file. NEVER commit this.
#
# Copy to ~/.config/media-ai/credentials.toml and `chmod 600` it: the CLI refuses to
# read a group- or world-readable one rather than silently trusting it.
# Override the location with $MEDIA_AI_CREDENTIALS_FILE.

# A flat namespace of *accounts*. `media-ai init` names one after the binding that
# uses it, so "which key did this binding use?" has a one-line answer.
["volc-ark/seedance-2.0"]
api_key = "your-ark-key"

["gemini/veo-3.1"]
api_key = "your-gemini-key"

# Or name one yourself and point several bindings at it, when sharing is deliberate:
#     [bindings."volc-ark/seedream-4.5"]
#     credential = "cred://shared-ark"
[shared-ark]
api_key = "your-ark-key"

# An account's value may itself be a reference, so a machine can keep every key in a
# vault and still name accounts locally.
[from-vault]
api_key = "op://vault/volc/api-key"

# Nothing here is consulted unless a binding names it. There is no precedence between
# sources and no fallback: `credential = "env://ARK_API_KEY"` reads that variable and
# nothing else, and a key sitting here under another name will not be substituted.
