# media-ai — bindings and scene defaults.
#
# NON-SECRET: safe to share or commit. `credential` is always a *reference*; a raw key
# here is refused, because this is the file meant to be shared.
#
# Copy to ~/.config/media-ai/config.toml (or point $MEDIA_CONFIG_FILE at it).
# `media-ai init` writes this for you; `media-ai bindings add` writes one entry.

schema = 2

# ---------------------------------------------------------------- bindings
#
# A binding is one callable (provider, model) pair. Each is self-contained: its own
# endpoint, its own credential. Two bindings on one account repeat the reference —
# deliberately, so this file says outright which key every call uses.
#
# See what exists:  media-ai bindings available

[bindings."volc-ark/seedance-2.0"]
credential = "env://ARK_API_KEY"

[bindings."volc-ark/seedream-4.5"]
credential = "env://ARK_API_KEY"

[bindings."gemini/veo-3.1"]
credential = "cred://gemini"          # the [gemini] account in credentials.toml

[bindings."openai/gpt-image-2"]
credential = "keychain://media-ai/openai"

# Per-binding knobs. These used to be environment variables, which made them global to
# the process — two endpoints could not want different deadlines. Unknown keys are
# ignored, so a newer config stays readable by an older CLI.
[bindings."volc-ark/seedance-2.0".options]
poll_interval = 5
poll_timeout  = 900

# ---------------------------------------------------------------- extends
#
# One mechanism, three uses: a second account, a second region, and an opaque
# deployment id. All three are "the same declared capabilities, reached differently".

# A second region.
[bindings."volc-ark-sg/seedance-2.0"]
extends    = "volc-ark/seedance-2.0"
base_url   = "https://ark.ap-southeast.volces.com/api/v3"
credential = "cred://volc-ark-sg"

# An Ark custom inference endpoint: `ep-…` names a deployment, not a model, so it
# carries no capability information of its own. `extends` says what it actually
# serves; the wire keeps the id the API accepts.
[bindings."volc-ark/my-endpoint"]
extends    = "volc-ark/seedream-4.5"
endpoint_id = "ep-example-endpoint"
credential = "env://ARK_API_KEY"

# ---------------------------------------------------------------- defaults
#
# Which binding runs when a call names none. This is the only automatic choice the CLI
# makes: `--provider`/`--model` are flags a model driving the CLI may not have learned,
# so a bare `media-ai video generate --prompt …` has to work.
#
# Set one:  media-ai config set-default video volc-ark/seedance-2.0

[defaults]
"image.text_to_image"      = "volc-ark/seedream-4.5"
"image.image_to_image"     = "volc-ark/seedream-4.5"
"video.text_to_video"      = "volc-ark/seedance-2.0"
"video.image_to_video"     = "volc-ark/seedance-2.0"
"video.keyframe_to_video"  = "volc-ark/seedance-2.0"
"video.reference_to_video" = "volc-ark/seedance-2.0"
"video.extend"             = "gemini/veo-3.1"
"video.concat"             = "local/ffmpeg"

# ------------------------------------------------------------------ update
#
# Whether this machine looks for a newer release, and where. Both optional — the
# table is absent on a fresh install, and absent means the defaults below.
#
# The check never happens during a generation: those read a cached answer and never
# wait on the network. A fetch happens in `media-ai init` and in
# `media-ai version check`, and never in CI.
#
# `feed` points an internal distribution at its own mirror once, here, rather than at
# every shell. `MEDIA_UPDATE_CHECK=0` and `MEDIA_UPDATE_FEED=…` override both for one
# machine; `media-ai version check` reports which layer won.

# [update]
# check = true                                  # false: never look for a new release
# feed  = "https://mirror.internal/feed.json"   # default: this project's published feed
