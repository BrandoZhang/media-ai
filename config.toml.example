# media-ai — bindings and scene defaults.
#
# NON-SECRET: safe to share or commit. `credential` is always a *reference*; a raw key
# here is refused, because this is the file meant to be shared.
#
# Copy to ~/.config/media-ai/config.toml (or point $MEDIA_CONFIG_FILE at it).
# `media-ai init` writes this for you; `media-ai bindings add` writes one entry.

schema = 2

# ---------------------------------------------------------------- bindings
#
# A binding is one callable (provider, model) pair. Each is self-contained: its own
# endpoint, its own credential. Two bindings on one account repeat the reference —
# deliberately, so this file says outright which key every call uses.
#
# See what exists:  media-ai bindings available

[bindings."volc-ark/seedance-2.0"]
credential = "env://ARK_API_KEY"

[bindings."volc-ark/seedream-4.5"]
credential = "env://ARK_API_KEY"

[bindings."gemini/veo-3.1"]
credential = "cred://gemini"          # the [gemini] account in credentials.toml

[bindings."openai/gpt-image-2"]
credential = "keychain://media-ai/openai"

# Per-binding knobs. These used to be environment variables, which made them global to
# the process — two endpoints could not want different deadlines. Unknown keys are
# ignored, so a newer config stays readable by an older CLI.
[bindings."volc-ark/seedance-2.0".options]
poll_interval = 5
poll_timeout  = 900

# ---------------------------------------------------------------- extends
#
# One mechanism, three uses: a second account, a second region, and an opaque
# deployment id. All three are "the same declared capabilities, reached differently".

# A second region.
[bindings."volc-ark-sg/seedance-2.0"]
extends    = "volc-ark/seedance-2.0"
base_url   = "https://ark.ap-southeast.volces.com/api/v3"
credential = "cred://volc-ark-sg"

# An Ark custom inference endpoint: `ep-…` names a deployment, not a model, so it
# carries no capability information of its own. `extends` says what it actually
# serves; the wire keeps the id the API accepts.
[bindings."volc-ark/my-endpoint"]
extends    = "volc-ark/seedream-4.5"
endpoint_id = "ep-example-endpoint"
credential = "env://ARK_API_KEY"

# ---------------------------------------------------------------- defaults
#
# Which binding runs when a call names none. This is the only automatic choice the CLI
# makes: `--provider`/`--model` are flags a model driving the CLI may not have learned,
# so a bare `media-ai video generate --prompt …` has to work.
#
# Set one:  media-ai config set-default video volc-ark/seedance-2.0

[defaults]
"image.text_to_image"      = "volc-ark/seedream-4.5"
"image.image_to_image"     = "volc-ark/seedream-4.5"
"video.text_to_video"      = "volc-ark/seedance-2.0"
"video.image_to_video"     = "volc-ark/seedance-2.0"
"video.keyframe_to_video"  = "volc-ark/seedance-2.0"
"video.reference_to_video" = "volc-ark/seedance-2.0"
"video.extend"             = "gemini/veo-3.1"
"video.concat"             = "local/ffmpeg"

# ------------------------------------------------------------------ update
#
# Whether this machine looks for a newer release, where, and how often. All optional —
# the table is absent on a fresh install, and absent means the defaults below.
#
# No command ever waits on this. A command reads the cached answer, and *after* it has
# printed its result it starts a detached background process that tops the cache up if
# it is older than `interval`. So the answer a call acts on is always a local file
# read, and a feed published today reaches an active machine on its next invocation.
#
# `interval` is the policy knob, not a performance one: the feed can say which versions
# are unsupported and which bindings have been withdrawn, and this is how long a machine
# may go without hearing it. 0 means check after every command.
#
# `feed` points an internal distribution at its own mirror once, here, rather than at
# every shell.
#
# Never in CI, and never for a development build. `MEDIA_UPDATE_CHECK=0`,
# `MEDIA_UPDATE_FEED=…` and `MEDIA_UPDATE_INTERVAL=…` override all three for one
# machine, and `MEDIA_UPDATE_CHECK=1` also overrules the CI rule for a runner that does
# want to be told. `media-ai version check` reports which layer won.

# [update]
# check    = true                                  # false: never look for a new release
# feed     = "https://mirror.internal/feed.json"   # default: this project's published feed
# interval = 86400                                 # seconds between background checks

# ------------------------------------------------------------- telemetry
#
# Structured logs are always on (stderr, `--log-level`). OpenTelemetry traces and
# metrics are not: a CLI that exports on first run ships the caller's prompts to a
# collector nobody declared, so the table is absent on a fresh install and absent means
# off. See docs/OBSERVABILITY.md.
#
# Needs the optional extra — `pip install "media-ai[otel]"`. Enabled without it, the
# CLI degrades to a no-op and says so in `notices[]` rather than failing a generation.
# `media-ai init` asks about this once the extra is installed (and `--telemetry-endpoint
# <url>` answers it unattended); `media-ai doctor` reports what is in effect.
#
# `MEDIA_TELEMETRY=0` overrides an `enabled = true` here, which is the point of the
# override: a config shared between machines, one of which must not export.
# `MEDIA_TELEMETRY_EXPORTER`, `MEDIA_TELEMETRY_ENDPOINT` and `MEDIA_TELEMETRY_TIMEOUT`
# override the rest for one invocation.
#
# There is deliberately no header or token key: a collector behind authentication is
# configured through OTel's own OTEL_EXPORTER_OTLP_HEADERS. This file is the shareable
# one — it refuses a raw provider key, and a collector token is the same kind of secret.

# [telemetry]
# enabled        = true
# exporter       = "otlp"                   # otlp | console (stderr) | none (record only)
# endpoint       = "http://localhost:4318"  # OTLP/HTTP base URL; /v1/traces etc. appended
# service        = "media-ai"               # service.name; default: this CLI's own name
# timeout        = 5                        # seconds for the whole flush at exit
# sample_percent = 100                      # whole percent of traces kept
# logs           = true                     # also export log records, correlated by trace id
